{
  "$defs": {
    "AntiGamingSummary": {
      "additionalProperties": false,
      "description": "Whether the score was earned by a behaviour the profile forbids.",
      "properties": {
        "flagged_behaviors": {
          "items": {
            "type": "string"
          },
          "title": "Flagged Behaviors",
          "type": "array"
        },
        "gaming_detected": {
          "title": "Gaming Detected",
          "type": "boolean"
        },
        "penalty_total": {
          "minimum": 0.0,
          "title": "Penalty Total",
          "type": "number"
        }
      },
      "required": [
        "gaming_detected",
        "flagged_behaviors",
        "penalty_total"
      ],
      "title": "AntiGamingSummary",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "Which other runs this one beat or lost to. Empty for a single run.",
      "properties": {
        "better_than": {
          "items": {
            "type": "string"
          },
          "title": "Better Than",
          "type": "array"
        },
        "worse_than": {
          "items": {
            "type": "string"
          },
          "title": "Worse Than",
          "type": "array"
        }
      },
      "title": "Comparison",
      "type": "object"
    },
    "OverallJudgement": {
      "additionalProperties": false,
      "description": "The single-line verdict of Formal Spec section 8.3.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "risky",
            "needs_more_test"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "confidence"
      ],
      "title": "OverallJudgement",
      "type": "object"
    },
    "Scores": {
      "additionalProperties": false,
      "description": "Formal Spec 8.3 scores, field by field: each in [0, 1], higher better,\nor null when the run could not judge it (the score breakdown says why).",
      "properties": {
        "crisis_resilience": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crisis Resilience"
        },
        "engineering_feasibility": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Engineering Feasibility"
        },
        "failure_resistance": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Resistance"
        },
        "governance_stability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Governance Stability"
        },
        "physical_possibility": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Physical Possibility"
        },
        "recovery_ability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recovery Ability"
        },
        "resource_efficiency": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resource Efficiency"
        },
        "risk_control": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk Control"
        },
        "strategic_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Strategic Value"
        },
        "system_robustness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "System Robustness"
        },
        "tactical_usefulness": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tactical Usefulness"
        }
      },
      "required": [
        "physical_possibility",
        "engineering_feasibility",
        "tactical_usefulness",
        "strategic_value",
        "governance_stability",
        "crisis_resilience",
        "resource_efficiency",
        "risk_control",
        "system_robustness",
        "failure_resistance",
        "recovery_ability"
      ],
      "title": "Scores",
      "type": "object"
    }
  },
  "$id": "skyvault/1.0/evaluation_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evaluation Result = Formal Spec section 8.3.\n\nImportant:\nThe first eight fields are the run-end summary the engine records in\nSCENARIO_END. Schema 0.4 makes the section 8.3 verdict required, as ADR\n004 promised, and adds what the verdict was reached under (profile_id,\nperspective), the overall score, and the anti-gaming summary that shows\nwhether a high score was earned by gaming.\n\nscores are the eleven of section 8.3, null where the run could not\njudge them. additional_axes are the other section 8.2 axes (time cost,\nresource cost, risk growth, commercial demonstrability, imperial core\nvalue) and the development plan's mission success, logistics burden and\nstability impact, null likewise.",
  "properties": {
    "active_entities": {
      "minimum": 0,
      "title": "Active Entities",
      "type": "integer"
    },
    "active_factions": {
      "items": {
        "type": "string"
      },
      "title": "Active Factions",
      "type": "array"
    },
    "additional_axes": {
      "additionalProperties": {
        "anyOf": [
          {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Additional Axes",
      "type": "object"
    },
    "anti_gaming": {
      "$ref": "#/$defs/AntiGamingSummary"
    },
    "comparison": {
      "$ref": "#/$defs/Comparison"
    },
    "destroyed_entities": {
      "minimum": 0,
      "title": "Destroyed Entities",
      "type": "integer"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "failure_causes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Causes",
      "type": "array"
    },
    "failure_points": {
      "items": {
        "type": "string"
      },
      "title": "Failure Points",
      "type": "array"
    },
    "key_findings": {
      "items": {
        "type": "string"
      },
      "title": "Key Findings",
      "type": "array"
    },
    "overall_judgement": {
      "$ref": "#/$defs/OverallJudgement"
    },
    "overall_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Overall Score",
      "type": "number"
    },
    "perspective": {
      "minLength": 1,
      "title": "Perspective",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "recommended_next_tests": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Next Tests",
      "type": "array"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/Scores"
    },
    "termination_reason": {
      "minLength": 1,
      "title": "Termination Reason",
      "type": "string"
    },
    "winner_or_result": {
      "minLength": 1,
      "title": "Winner Or Result",
      "type": "string"
    }
  },
  "required": [
    "termination_reason",
    "event_count",
    "active_entities",
    "destroyed_entities",
    "active_factions",
    "winner_or_result",
    "key_findings",
    "failure_points",
    "scenario_id",
    "profile_id",
    "perspective",
    "overall_judgement",
    "overall_score",
    "scores",
    "additional_axes",
    "failure_causes",
    "recommended_next_tests",
    "comparison",
    "anti_gaming"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
