{
  "$defs": {
    "AntiGamingSummary": {
      "additionalProperties": false,
      "description": "Whether the score was earned by a behaviour the profile forbids.",
      "properties": {
        "flagged_behaviors": {
          "items": {
            "type": "string"
          },
          "title": "Flagged Behaviors",
          "type": "array"
        },
        "gaming_detected": {
          "title": "Gaming Detected",
          "type": "boolean"
        },
        "penalty_total": {
          "minimum": 0.0,
          "title": "Penalty Total",
          "type": "number"
        }
      },
      "required": [
        "gaming_detected",
        "flagged_behaviors",
        "penalty_total"
      ],
      "title": "AntiGamingSummary",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "Which other runs this one beat or lost to. Empty for a single run.",
      "properties": {
        "better_than": {
          "items": {
            "type": "string"
          },
          "title": "Better Than",
          "type": "array"
        },
        "worse_than": {
          "items": {
            "type": "string"
          },
          "title": "Worse Than",
          "type": "array"
        }
      },
      "title": "Comparison",
      "type": "object"
    },
    "OverallJudgement": {
      "additionalProperties": false,
      "description": "The single-line verdict of Formal Spec section 8.3.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "risky",
            "needs_more_test"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "confidence"
      ],
      "title": "OverallJudgement",
      "type": "object"
    }
  },
  "$id": "skyvault/0.6/evaluation_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evaluation Result = Formal Spec section 8.3.\n\nImportant:\nThe first eight fields are the run-end summary the engine records in\nSCENARIO_END. Schema 0.4 makes the section 8.3 verdict required, as ADR\n004 promised, and adds what the verdict was reached under (profile_id,\nperspective), the overall score, and the anti-gaming summary that shows\nwhether a high score was earned by gaming.\n\nscores holds every axis that had data, each in [0, 1], higher better.",
  "properties": {
    "active_entities": {
      "minimum": 0,
      "title": "Active Entities",
      "type": "integer"
    },
    "active_factions": {
      "items": {
        "type": "string"
      },
      "title": "Active Factions",
      "type": "array"
    },
    "anti_gaming": {
      "$ref": "#/$defs/AntiGamingSummary"
    },
    "comparison": {
      "$ref": "#/$defs/Comparison"
    },
    "destroyed_entities": {
      "minimum": 0,
      "title": "Destroyed Entities",
      "type": "integer"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "failure_causes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Causes",
      "type": "array"
    },
    "failure_points": {
      "items": {
        "type": "string"
      },
      "title": "Failure Points",
      "type": "array"
    },
    "key_findings": {
      "items": {
        "type": "string"
      },
      "title": "Key Findings",
      "type": "array"
    },
    "overall_judgement": {
      "$ref": "#/$defs/OverallJudgement"
    },
    "overall_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Overall Score",
      "type": "number"
    },
    "perspective": {
      "minLength": 1,
      "title": "Perspective",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "recommended_next_tests": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Next Tests",
      "type": "array"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scores": {
      "additionalProperties": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
      },
      "title": "Scores",
      "type": "object"
    },
    "termination_reason": {
      "minLength": 1,
      "title": "Termination Reason",
      "type": "string"
    },
    "winner_or_result": {
      "minLength": 1,
      "title": "Winner Or Result",
      "type": "string"
    }
  },
  "required": [
    "termination_reason",
    "event_count",
    "active_entities",
    "destroyed_entities",
    "active_factions",
    "winner_or_result",
    "key_findings",
    "failure_points",
    "scenario_id",
    "profile_id",
    "perspective",
    "overall_judgement",
    "overall_score",
    "scores",
    "failure_causes",
    "recommended_next_tests",
    "comparison",
    "anti_gaming"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
