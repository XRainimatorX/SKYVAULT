{
  "$defs": {
    "RunMetadata": {
      "additionalProperties": false,
      "description": "When and where a run happened.",
      "properties": {
        "compute_profile": {
          "default": "",
          "title": "Compute Profile",
          "type": "string"
        },
        "ended_at": {
          "minLength": 1,
          "title": "Ended At",
          "type": "string"
        },
        "operator_system": {
          "default": "",
          "title": "Operator System",
          "type": "string"
        },
        "started_at": {
          "minLength": 1,
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "ended_at"
      ],
      "title": "RunMetadata",
      "type": "object"
    }
  },
  "$id": "skyvault/0.5/reproducibility.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reproducibility Metadata = Formal Spec section 12.2.\n\nImportant:\nEvery result package carries this from Phase 8 on. input_hash covers the\nscenario and the evaluation profile; output_hash covers the whole result\npackage except this block, which records when the run happened and so can\nnever repeat. Two runs with the same output_hash produced the same result.\n\nrandom_seed is null for a stochastic run, which cannot be replayed.",
  "properties": {
    "deterministic_replay_available": {
      "title": "Deterministic Replay Available",
      "type": "boolean"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "random_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Random Seed"
    },
    "random_seed_policy": {
      "enum": [
        "fixed",
        "controlled_random",
        "stochastic"
      ],
      "title": "Random Seed Policy",
      "type": "string"
    },
    "ruleset_version": {
      "minLength": 1,
      "title": "Ruleset Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_metadata": {
      "$ref": "#/$defs/RunMetadata"
    },
    "runtime_version": {
      "minLength": 1,
      "title": "Runtime Version",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "minLength": 1,
      "title": "Scenario Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "scenario_version",
    "random_seed_policy",
    "random_seed",
    "runtime_version",
    "ruleset_version",
    "input_hash",
    "output_hash",
    "deterministic_replay_available",
    "run_metadata"
  ],
  "title": "ReproducibilityMetadata",
  "type": "object"
}
