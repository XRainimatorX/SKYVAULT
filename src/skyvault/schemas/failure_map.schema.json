{
  "$defs": {
    "AlternativeResult": {
      "additionalProperties": false,
      "properties": {
        "baseline_survival_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Baseline Survival Rate",
          "type": "number"
        },
        "breaking_levels": {
          "additionalProperties": {
            "anyOf": [
              {
                "enum": [
                  "mild",
                  "moderate",
                  "severe",
                  "collapse"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Breaking Levels",
          "type": "object"
        },
        "breaks_sooner_on": {
          "items": {
            "type": "string"
          },
          "title": "Breaks Sooner On",
          "type": "array"
        },
        "holds_longer_on": {
          "items": {
            "type": "string"
          },
          "title": "Holds Longer On",
          "type": "array"
        },
        "scenario_version": {
          "minLength": 1,
          "title": "Scenario Version",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "holds_longer",
            "breaks_sooner",
            "mixed",
            "same"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "scenario_version",
        "baseline_survival_rate",
        "breaking_levels",
        "holds_longer_on",
        "breaks_sooner_on",
        "verdict"
      ],
      "title": "AlternativeResult",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "fails_without_stress": {
          "title": "Fails Without Stress",
          "type": "boolean"
        },
        "mean_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Score",
          "type": "number"
        },
        "outcomes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "survival_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Survival Rate",
          "type": "number"
        }
      },
      "required": [
        "survival_rate",
        "mean_score",
        "outcomes",
        "fails_without_stress"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "BranchResult": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "mild",
            "moderate",
            "severe",
            "collapse"
          ],
          "title": "Level",
          "type": "string"
        },
        "mean_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Score",
          "type": "number"
        },
        "survival_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Survival Rate",
          "type": "number"
        },
        "variables": {
          "items": {
            "enum": [
              "supply_delay",
              "sensor_failure",
              "communication_failure",
              "weather_degradation",
              "enemy_reaction_speed",
              "equipment_overheat",
              "civilian_pressure",
              "resource_shortage",
              "public_order_collapse",
              "encirclement",
              "intelligence_error",
              "formation_collapse",
              "tempo_delay",
              "administration_collapse",
              "public_sentiment_decline",
              "endurance_shortfall",
              "energy_depletion",
              "misidentification",
              "reaction_delay",
              "target_saturation",
              "collision",
              "path_blocked"
            ],
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "variables",
        "level",
        "survival_rate",
        "mean_score"
      ],
      "title": "BranchResult",
      "type": "object"
    },
    "CrushingVariable": {
      "additionalProperties": false,
      "properties": {
        "breaking_level": {
          "anyOf": [
            {
              "enum": [
                "mild",
                "moderate",
                "severe",
                "collapse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Breaking Level"
        },
        "variable": {
          "enum": [
            "supply_delay",
            "sensor_failure",
            "communication_failure",
            "weather_degradation",
            "enemy_reaction_speed",
            "equipment_overheat",
            "civilian_pressure",
            "resource_shortage",
            "public_order_collapse",
            "encirclement",
            "intelligence_error",
            "formation_collapse",
            "tempo_delay",
            "administration_collapse",
            "public_sentiment_decline",
            "endurance_shortfall",
            "energy_depletion",
            "misidentification",
            "reaction_delay",
            "target_saturation",
            "collision",
            "path_blocked"
          ],
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "breaking_level"
      ],
      "title": "CrushingVariable",
      "type": "object"
    },
    "FailureAnswers": {
      "additionalProperties": false,
      "description": "Formal Spec 14.4, one field per question: 在哪裡死、為什麼死、多快死、\n哪個假設害死、哪個變量壓垮、哪個替代方案活得更久、現實行動前必須改什麼.",
      "properties": {
        "how_fast_it_failed": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "How Fast It Failed",
          "type": "object"
        },
        "what_must_change": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "What Must Change",
          "type": "array"
        },
        "where_it_failed": {
          "items": {
            "type": "string"
          },
          "title": "Where It Failed",
          "type": "array"
        },
        "which_alternative_survived_longer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Which Alternative Survived Longer"
        },
        "which_assumption_caused_it": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Which Assumption Caused It"
        },
        "which_variable_pushed_it_over": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrushingVariable"
            },
            {
              "type": "null"
            }
          ]
        },
        "why_it_failed": {
          "items": {
            "type": "string"
          },
          "title": "Why It Failed",
          "type": "array"
        }
      },
      "required": [
        "where_it_failed",
        "why_it_failed",
        "how_fast_it_failed",
        "which_assumption_caused_it",
        "which_variable_pushed_it_over",
        "which_alternative_survived_longer",
        "what_must_change"
      ],
      "title": "FailureAnswers",
      "type": "object"
    },
    "FailureOutput": {
      "additionalProperties": false,
      "description": "Formal Spec 14.3 failure_exploration.output, filled.",
      "properties": {
        "collapse_sequence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Collapse Sequence",
          "type": "array"
        },
        "failure_points": {
          "items": {
            "type": "string"
          },
          "title": "Failure Points",
          "type": "array"
        },
        "recommended_modifications": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Recommended Modifications",
          "type": "array"
        },
        "survival_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Survival Conditions",
          "type": "array"
        }
      },
      "required": [
        "failure_points",
        "collapse_sequence",
        "survival_conditions",
        "recommended_modifications"
      ],
      "title": "FailureOutput",
      "type": "object"
    },
    "LevelResult": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "mild",
            "moderate",
            "severe",
            "collapse"
          ],
          "title": "Level",
          "type": "string"
        },
        "mean_first_loss_tick": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean First Loss Tick"
        },
        "mean_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Score",
          "type": "number"
        },
        "most_common_failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Most Common Failure"
        },
        "survival_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Survival Rate",
          "type": "number"
        }
      },
      "required": [
        "level",
        "survival_rate",
        "mean_score",
        "mean_first_loss_tick",
        "most_common_failure"
      ],
      "title": "LevelResult",
      "type": "object"
    },
    "VariableResult": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "assumption": {
          "title": "Assumption",
          "type": "string"
        },
        "breaking_level": {
          "anyOf": [
            {
              "enum": [
                "mild",
                "moderate",
                "severe",
                "collapse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Breaking Level"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/LevelResult"
          },
          "title": "Levels",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sensitivity": {
          "title": "Sensitivity",
          "type": "number"
        },
        "variable": {
          "enum": [
            "supply_delay",
            "sensor_failure",
            "communication_failure",
            "weather_degradation",
            "enemy_reaction_speed",
            "equipment_overheat",
            "civilian_pressure",
            "resource_shortage",
            "public_order_collapse",
            "encirclement",
            "intelligence_error",
            "formation_collapse",
            "tempo_delay",
            "administration_collapse",
            "public_sentiment_decline",
            "endurance_shortfall",
            "energy_depletion",
            "misidentification",
            "reaction_delay",
            "target_saturation",
            "collision",
            "path_blocked"
          ],
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "applicable",
        "reason",
        "assumption",
        "levels",
        "breaking_level",
        "sensitivity"
      ],
      "title": "VariableResult",
      "type": "object"
    }
  },
  "$id": "skyvault/1.0/failure_map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The failure map a failure exploration produces (development plan Phase 9).\n\nImportant:\nIt answers the section 14 questions in fixed places: where the plan fails\n(failure_points), why (failure_causes), how fast (how_fast), which\nvariable crushes it and which assumption that attacks (crushing_variable,\ncrushing_assumption), and which alternative lasts longer (alternatives).\noutput is the section 14.3 output block and answers the seven questions\nof 14.4, what must change before acting included.",
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/AlternativeResult"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "answers": {
      "$ref": "#/$defs/FailureAnswers"
    },
    "baseline": {
      "$ref": "#/$defs/Baseline"
    },
    "best_alternative": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Best Alternative"
    },
    "branches": {
      "items": {
        "$ref": "#/$defs/BranchResult"
      },
      "title": "Branches",
      "type": "array"
    },
    "crushing_assumption": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Crushing Assumption"
    },
    "crushing_variable": {
      "anyOf": [
        {
          "enum": [
            "supply_delay",
            "sensor_failure",
            "communication_failure",
            "weather_degradation",
            "enemy_reaction_speed",
            "equipment_overheat",
            "civilian_pressure",
            "resource_shortage",
            "public_order_collapse",
            "encirclement",
            "intelligence_error",
            "formation_collapse",
            "tempo_delay",
            "administration_collapse",
            "public_sentiment_decline",
            "endurance_shortfall",
            "energy_depletion",
            "misidentification",
            "reaction_delay",
            "target_saturation",
            "collision",
            "path_blocked"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Crushing Variable"
    },
    "failure_causes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Causes",
      "type": "array"
    },
    "failure_points": {
      "items": {
        "type": "string"
      },
      "title": "Failure Points",
      "type": "array"
    },
    "how_fast": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "How Fast",
      "type": "object"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/FailureOutput"
    },
    "perspective": {
      "minLength": 1,
      "title": "Perspective",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "repeat_count": {
      "minimum": 1,
      "title": "Repeat Count",
      "type": "integer"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "minLength": 1,
      "title": "Scenario Version",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "survival_threshold": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Survival Threshold",
      "type": "number"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/VariableResult"
      },
      "title": "Variables",
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "scenario_version",
    "perspective",
    "profile_id",
    "objective",
    "repeat_count",
    "seeds",
    "survival_threshold",
    "baseline",
    "variables",
    "crushing_variable",
    "crushing_assumption",
    "failure_points",
    "failure_causes",
    "how_fast",
    "branches",
    "alternatives",
    "best_alternative",
    "output",
    "answers"
  ],
  "title": "FailureMap",
  "type": "object"
}
