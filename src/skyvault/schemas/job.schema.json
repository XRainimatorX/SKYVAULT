{
  "$defs": {
    "DataProvenance": {
      "additionalProperties": false,
      "description": "Data Provenance = Formal Spec section 11.3.\n\nImportant:\nSection 2.3 sketches world_contract.data_provenance as a flat block. No\nscenario carries provenance yet, so there is no existing shape to keep;\nboth places use this dedicated section 11.3 contract. See ADR 004.",
      "properties": {
        "missing_data": {
          "items": {
            "type": "string"
          },
          "title": "Missing Data",
          "type": "array"
        },
        "reliability_notes": {
          "items": {
            "type": "string"
          },
          "title": "Reliability Notes",
          "type": "array"
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ProvenanceSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "DataProvenance",
      "type": "object"
    },
    "EntityChange": {
      "additionalProperties": false,
      "description": "What a request changes on one unit; capabilities and state are merged.\nposition moves it (Phase 15: AEROGRID repositions a sensor); the\nscenario contract still checks it is inside the space.",
      "properties": {
        "capabilities": {
          "additionalProperties": true,
          "title": "Capabilities",
          "type": "object"
        },
        "entity_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Type"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "state": {
          "additionalProperties": true,
          "title": "State",
          "type": "object"
        }
      },
      "title": "EntityChange",
      "type": "object"
    },
    "GovernanceRecord": {
      "additionalProperties": false,
      "description": "What one run used, under which policy, and whether it was stopped.\n\nImportant:\nA run nobody governed records policy_id \"ungoverned\" and no limits. A\nstopped run is partial: it ended early and its result covers what had\nhappened by then. duration_clamped_from is the max_ticks a job asked for\nwhen the policy cut it to max_scenario_duration.",
      "properties": {
        "duration_clamped_from": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Clamped From"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "limits": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limits"
        },
        "partial": {
          "title": "Partial",
          "type": "boolean"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "run_priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high",
            "critical"
          ],
          "title": "Run Priority",
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "budget_exceeded",
                "infinite_loop_detected",
                "no_new_state_change",
                "failure_threshold_reached",
                "max_runtime_exceeded",
                "resource_cap_reached",
                "cancelled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stop Reason"
        },
        "stopped": {
          "title": "Stopped",
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "policy_id",
        "limits",
        "usage",
        "stopped",
        "stop_reason",
        "partial"
      ],
      "title": "GovernanceRecord",
      "type": "object"
    },
    "JobRequest": {
      "additionalProperties": false,
      "description": "What a system asks the service to do (task_intake).\n\nImportant:\nruntime overrides the scenario's runtime block (max_ticks, random_seed,\npolicy, participants); replay names the job whose run to replay;\nbranches are a branch_compare's named action sets (Phase 12), each\n{branch_id, actions, entity_changes}. entity_changes replaces named\nunits' capabilities, state, name or type ({entity_id: {field: ...}});\ndata_provenance records where those changes came from (Phase 12: what\nEIDEN-01 and STAR GUARD submit).",
      "properties": {
        "batch": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.+-]+(/[A-Za-z0-9_.+-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch"
        },
        "branches": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branches"
        },
        "data_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity_changes": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/EntityChange"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Changes"
        },
        "kind": {
          "enum": [
            "scenario_run",
            "batch",
            "failure_exploration",
            "replay",
            "persistent_world",
            "branch_compare"
          ],
          "title": "Kind",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "normal",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.+-]+(/[A-Za-z0-9_.+-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "repeat_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Count"
        },
        "replay": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay"
        },
        "required_result_package": {
          "default": true,
          "title": "Required Result Package",
          "type": "boolean"
        },
        "runtime": {
          "additionalProperties": true,
          "title": "Runtime",
          "type": "object"
        },
        "scenario": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.+-]+(/[A-Za-z0-9_.+-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        },
        "source_system": {
          "default": "user",
          "minLength": 1,
          "title": "Source System",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "JobRequest",
      "type": "object"
    },
    "ProvenanceSource": {
      "additionalProperties": false,
      "description": "One source of scenario data.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "modified_by": {
          "default": "",
          "title": "Modified By",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "EIDEN_01",
            "STARTX",
            "manual_input",
            "external_data",
            "historical_record"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "timestamp": {
          "default": "",
          "title": "Timestamp",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "confidence"
      ],
      "title": "ProvenanceSource",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "What was used. A batch or an exploration counts runs and events; ticks\nand decisions are counted for single runs only (null otherwise).",
      "properties": {
        "decisions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decisions"
        },
        "events": {
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "runs": {
          "default": 1,
          "minimum": 1,
          "title": "Runs",
          "type": "integer"
        },
        "runtime_seconds": {
          "minimum": 0.0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ticks"
        }
      },
      "required": [
        "ticks",
        "decisions",
        "events",
        "runtime_seconds"
      ],
      "title": "Usage",
      "type": "object"
    },
    "WorldInstance": {
      "additionalProperties": false,
      "properties": {
        "lifecycle_state": {
          "enum": [
            "created",
            "initialized",
            "running",
            "paused",
            "completed",
            "failed",
            "archived",
            "replayed",
            "deleted"
          ],
          "title": "Lifecycle State",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "world_id": {
          "minLength": 1,
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id",
        "scenario_id",
        "lifecycle_state"
      ],
      "title": "WorldInstance",
      "type": "object"
    }
  },
  "$id": "skyvault/0.6/job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A job as the service keeps it.",
  "properties": {
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "estimated_cost": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost"
    },
    "governance": {
      "anyOf": [
        {
          "$ref": "#/$defs/GovernanceRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "lifecycle_state": {
      "enum": [
        "created",
        "initialized",
        "running",
        "paused",
        "completed",
        "failed",
        "archived",
        "replayed",
        "deleted"
      ],
      "title": "Lifecycle State",
      "type": "string"
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "title": "Priority",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/JobRequest"
    },
    "summary": {
      "additionalProperties": true,
      "title": "Summary",
      "type": "object"
    },
    "updated_at": {
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    },
    "world_instance": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorldInstance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "request",
    "priority",
    "lifecycle_state",
    "created_at",
    "updated_at"
  ],
  "title": "Job",
  "type": "object"
}
