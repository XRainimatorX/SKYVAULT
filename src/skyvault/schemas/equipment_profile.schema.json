  "$id": "skyvault/0.6/equipment_profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One piece of equipment, before it is built (section 18).\n\ncapabilities and state are the Phase 12 path: they are copied onto the\nreplaced unit as they are, after the profile's own mapping.",
  "properties": {
    "capabilities": {
      "additionalProperties": true,
      "title": "Capabilities",
      "type": "object"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "engineering_parameters": {
      "$ref": "#/$defs/EngineeringParameters"
    },
    "equipment_id": {
      "minLength": 1,
      "title": "Equipment Id",
      "type": "string"
    },
    "operational_parameters": {
      "$ref": "#/$defs/OperationalParameters"
    },
    "physical_parameters": {
      "$ref": "#/$defs/PhysicalParameters"
    },
    "state": {
      "additionalProperties": true,
      "title": "State",
      "type": "object"
    },
    "test_targets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Test Targets",
      "type": "array"
    }
  },
  "required": [
    "equipment_id",
    "category"
  ],
  "title": "EquipmentProfile",
  "type": "object"
