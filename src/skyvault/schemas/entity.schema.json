{
  "$id": "skyvault/0.5/entity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Entity = something that exists inside the world.\n\nImportant:\nposition is an [x, y] cell on a grid space, or a node id on a graph or\nnetwork space.\n\nstate holds what changes (hp, ap, status); capabilities holds what the\nentity can do (attack_damage, attack_range, accuracy). The contract keeps\nthem as open mappings because their keys belong to the domain, not to core.",
  "properties": {
    "capabilities": {
      "additionalProperties": true,
      "title": "Capabilities",
      "type": "object"
    },
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "title": "Entity Type",
      "type": "string"
    },
    "faction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Faction"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "position": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Position"
    },
    "state": {
      "additionalProperties": true,
      "title": "State",
      "type": "object"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "entity_id",
    "name",
    "entity_type",
    "faction",
    "position"
  ],
  "title": "EntityRecord",
  "type": "object"
}
