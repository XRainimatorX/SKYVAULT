  "assumption_registry": {
    "scenario_id": "city_takeover_001",
    "assumptions": [
      {
        "assumption_id": "coefficient.information_defaults.shortage",
        "description": "pressure points per step while a district has less than a step's food (assumed). Direction and the threshold form (shortage is on or off) follow the studies; the size is not converted: the studies give a probability change, the model a pressure score.",
        "category": "coefficient",
        "value": 4.0,
        "confidence": 0.3,
        "criticality": "low"
      },
      {
        "assumption_id": "coefficient.information_defaults.dark",
        "description": "pressure points per step without power, times the night share of the step (assumed). Timing follows the Cape Town study (night share of the step, see time.night_from / night_to); the size is not converted and may be zero (Texas).",
        "category": "coefficient",
        "value": 3.0,
        "confidence": 0.3,
        "criticality": "low"
      },
      {
        "assumption_id": "coefficient.information_defaults.unrest",
        "description": "pressure points per step in unrest (twice in riot) (assumed). Chosen in Phase 22 so a district in unrest grows uneasy within a few steps.",
        "category": "coefficient",
        "value": 2.0,
        "confidence": 0.3,
        "criticality": "low"
      },
      {
        "assumption_id": "coefficient.information_defaults.spread",
        "description": "share of a neighbour's higher pressure taken per step, times its communication (assumed). Direction only; the rate is a Phase 22 choice.",
        "category": "coefficient",
        "value": 0.25,
        "confidence": 0.3,
        "criticality": "low"
      },
      {
